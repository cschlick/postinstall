#!/usr/sbin/nft -f
# {{ ansible_managed }}
# nftables ruleset (port of configs/nftables/nftables.conf).
# Edit the role vars (nftables_ssh_port, nftables_extra_tcp_ports), not this file.

flush ruleset

table inet filter {

    chain input {
        type filter hook input priority filter; policy drop;

        # allow loopback
        iif lo accept

        # allow established/related
        ct state established,related accept

        # ICMPv4
        ip protocol icmp icmp type {
            echo-request,           # ping — allows others to reach this host
            destination-unreachable, # tells sender a host/port/network can't be reached; needed for PMTUD
            time-exceeded           # TTL expired in transit; required for traceroute to work
        } accept

        # ICMPv6 (essential types only)
        # ICMPv6 is far more critical than ICMPv4 — IPv6 uses it for neighbour
        # discovery (the ARP equivalent) and path MTU detection. Blocking it
        # breaks IPv6 connectivity entirely, not just ping.
        ip6 nexthdr icmpv6 icmpv6 type {
            destination-unreachable, # host/port/network unreachable; needed for PMTUD
            packet-too-big,          # path MTU discovery — tells sender to fragment; mandatory in IPv6
            time-exceeded,           # TTL/hop-limit expired; needed for traceroute
            parameter-problem,       # malformed IPv6 header; sender needs this to diagnose errors
            echo-request,            # ping
            echo-reply,              # ping reply
            nd-neighbor-solicit,     # neighbour discovery — equivalent to ARP request; resolves IPv6 → MAC
            nd-neighbor-advert,      # neighbour discovery — equivalent to ARP reply
            nd-router-advert         # router sends network prefix and gateway info to hosts
        } accept

        # gw-door (transient enrollment interface) matches the gw-* glob used
        # below, but must carry ONLY the enrollment exchange: accept its one
        # port here, then drop everything else arriving on it — BEFORE any
        # gw-* rule can match. (established/related + ICMP above still apply.)
        iifname "gw-door" tcp dport 51903 ct state new accept
        iifname "gw-door" drop

        # SSH always reachable over the VPN overlay — the gw_node profile relies
        # on this as its only path in.
        iifname "{{ nftables_mesh_iifname }}" tcp dport {{ nftables_ssh_port }} ct state new accept
{% if nftables_ssh_public %}
        # Default profile (nftables_ssh_public): also reachable from the public
        # internet — IPv6 only, by design. The gw_node profile sets this false to
        # restrict SSH to the overlay above. No rate limit: an accept-side limiter
        # fails INTO the drop policy past the threshold, locking out bursts.
        ip6 saddr ::/0 tcp dport {{ nftables_ssh_port }} ct state new accept
{% if nftables_ssh_ipv4 %}
        # dev profile: SSH from IPv4 too (sshd listens on 0.0.0.0 via
        # ssh_listen_ipv4).
        ip saddr 0.0.0.0/0 tcp dport {{ nftables_ssh_port }} ct state new accept
{% endif %}
{% endif %}

{% for port in nftables_extra_tcp_ports %}
        # Extra allowed inbound TCP (IPv4 and IPv6, public).
        tcp dport {{ port }} ct state new accept
{% endfor %}
{% for port in nftables_mesh_tcp_ports %}
        # Mesh-only service port: reachable ONLY over the overlay.
        iifname "{{ nftables_mesh_iifname }}" tcp dport {{ port }} ct state new accept
{% endfor %}

        # greasewood + wireguard. The two WireGuard UDP ports face the underlay
        # (they arrive on the physical NIC), so they accept from anywhere — over
        # BOTH families: greasewood's overlay is v6-only but the underlay may be
        # v4 or v6, so a peer (or the anchor's door) can be dialed over IPv4. On a
        # v6-only host the v4 rule simply never matches (no public v4 address).
        # The control plane binds only to the overlay + loopback and is scoped to
        # the mesh interfaces — nothing reaches it off the underlay even if a
        # bind ever regressed. (The enrollment port, 51903 on gw-door, is
        # handled by the early gw-door dispatch above.)
        # Same on every node so any node can become the hub with no rule change.
        ip6 saddr ::/0 udp dport { 51900, 51901 } ct state new accept
        ip saddr 0.0.0.0/0 udp dport { 51900, 51901 } ct state new accept
        iifname "{{ nftables_mesh_iifname }}" tcp dport 51902 ct state new accept

        # Log anything that reaches the end of the chain before the default
        # drop policy takes it. Rate-limited so a flood can't fill the journal;
        # view with: journalctl -k | grep 'nft-input-drop'
        limit rate 3/second burst 10 packets log prefix "nft-input-drop: " level info counter

    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
