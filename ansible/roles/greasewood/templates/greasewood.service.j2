# Managed by Ansible (roles/greasewood). Mirrors greasewood/systemd/.
[Unit]
Description=greasewood mesh daemon
Documentation={{ greasewood_repo }}
After=network-online.target
Wants=network-online.target
# Only run once this node has been configured. setup-hub / join writes the
# config; the companion greasewood.path unit starts us when it appears.
ConditionPathExists=/etc/greasewood.toml

[Service]
Type=simple
# gw run creates WireGuard interfaces and edits policy routing → runs as root.
ExecStart={{ greasewood_bin }} run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
