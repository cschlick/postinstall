{# Managed by Ansible (roles/chat_server). GHCR pull secret — the package is
   private, so podman needs read:packages to pull the image. 0600 root. Shared
   path with the account plane (a host runs one plane). #}
{
  "auths": {
    "{{ flutter_ghcr_registry }}": {
      "auth": "{{ (flutter_ghcr_user ~ ':' ~ flutter_ghcr_token) | b64encode }}"
    }
  }
}
