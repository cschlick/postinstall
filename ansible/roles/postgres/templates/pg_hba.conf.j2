# {{ ansible_managed }}
# Local unix-socket admin (peer = same OS user), unchanged from Debian stock.
# `local all all peer` is what lets a co-located app connect as its own OS user
# (e.g. the account container's pm uid -> the pm role) with no password/TLS.
local   all   postgres   peer
local   all   all        peer
{% if not postgres_socket_only %}

# mTLS-only TCP access, mirroring the nats role's verify:true — possession of a
# client cert signed by the mesh CA IS the credential (clientcert=verify-ca).
# There is NO non-TLS TCP path: plaintext and certless connections have no
# matching line and are rejected outright. Tighten to auth method `cert` later
# if you want the cert CN to have to match the database user.
hostssl all   all   ::/0        trust clientcert=verify-ca
hostssl all   all   0.0.0.0/0   trust clientcert=verify-ca
{% endif %}
