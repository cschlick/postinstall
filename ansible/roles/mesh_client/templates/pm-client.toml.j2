# {{ ansible_managed }}
# Rendered by Ansible (role {{ ansible_role_name }}) — the postmodern mesh CLIENT
# identity. pm-specific (owner {{ mesh_client_user }}, under {{ mesh_client_tls_dir }});
# handed to `gw cert-request --profile <this path>`, so it never enters greasewood's
# generic profile set. Generic file names (client.*) — reusable for DB / NATS / any
# mesh client. Every mesh leaf cert carries clientAuth EKU, so it authenticates as a
# client. No reload: consumers read the files fresh (the plane role restarts as needed).
reload = ""

[[file]]
role  = "key"
# 0600: the consumer runs AS pm (the owner), and libpq refuses a user-owned key
# with any group/world access (0640 is only allowed for a root-owned key).
path  = "{{ mesh_client_tls_dir }}/client.key"
owner = "{{ mesh_client_user }}:{{ mesh_client_group }}"
mode  = "0600"

[[file]]
role  = "cert"
path  = "{{ mesh_client_tls_dir }}/client.crt"
owner = "{{ mesh_client_user }}:{{ mesh_client_group }}"
mode  = "0644"

[[file]]
role  = "ca"
path  = "{{ mesh_client_tls_dir }}/ca.crt"
owner = "{{ mesh_client_user }}:{{ mesh_client_group }}"
mode  = "0644"
