# Managed by Ansible (roles/seed). Read by podman (root) and injected into the
# one-shot container. Config surface: postmodern-server/demos/seed.py + harness.py.
CHAT_WS_URL={{ seed_chat_ws_url }}
ACCOUNT_WS_URL={{ seed_account_ws_url }}
CHAT_DB_URL={{ seed_chat_db_url_effective }}
CHAT_BOT_CLAIM_SECRET={{ seed_chat_bot_claim_secret }}
SEED_PW={{ seed_pw }}
SEED_SMALL={{ '1' if seed_small else '0' }}
{% for k, v in seed_env_extra.items() %}
{{ k }}={{ v }}
{% endfor %}
# ACCOUNT_DB_URL intentionally unset — irl badges skipped (no accounts repo in image).
