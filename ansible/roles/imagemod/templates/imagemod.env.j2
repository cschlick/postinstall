# Managed by Ansible (roles/imagemod). Read by podman (root) and injected into the
# container. Config surface: postmodern-imagemod/API.md + README. The only required
# value is the Bearer API key; everything else defaults inside the image.
API_KEY={{ imagemod_api_key }}
{% for k, v in imagemod_env_extra.items() %}
{{ k }}={{ v }}
{% endfor %}
