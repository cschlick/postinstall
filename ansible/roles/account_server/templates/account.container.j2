{# Managed by Ansible (roles/account_server). Quadlet → systemd generates
   account.service on `systemctl daemon-reload`. Runtime contract:
   postmodern-accounts/CONTAINER.md. #}
[Unit]
Description=postmodern account server (container)
Documentation=https://github.com/postmodern-you/postmodern-accounts
After=network-online.target
Wants=network-online.target

[Container]
Image={{ account_image }}
# Private GHCR package → podman finds the read:packages authfile via
# REGISTRY_AUTH_FILE in [Service] below. (AuthFile= is NOT a valid quadlet
# [Container] key — it makes the generator reject the whole unit.)
Pull=missing
# host stack: reach the REMOTE Postgres (mesh gw-* or managed) with no container
# networking, and let the host nftables govern :{{ account_port }} directly.
Network=host
EnvironmentFile={{ account_env_file }}
# Secrets (DB TLS material + the anon-issuer key) bind-mounted read-only. The image
# runs as uid {{ account_uid }}; rootful podman maps that to the host pm user that owns these.
Volume={{ account_secrets_dir }}:{{ account_secrets_dir }}:ro
{% if account_db_local %}
# Local DB: bind-mount the postgres socket dir so the container reaches the
# co-located cluster over the Unix socket (peer auth as pm — no TLS/password).
Volume={{ account_db_socket_dir }}:{{ account_db_socket_dir }}:ro
{% endif %}

[Service]
# Give podman the GHCR pull-secret (quadlet has no [Container] AuthFile key).
Environment=REGISTRY_AUTH_FILE={{ account_authfile }}
Restart=on-failure
RestartSec=5
# first boot pulls the image — give it room before systemd calls the start failed.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
