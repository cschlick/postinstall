# Managed by Ansible (roles/account_server). Read by podman (root) and injected
# into the container. Config surface: postmodern-accounts/config.py + CONTAINER.md.
# NOTE: ACCOUNT_HOST is intentionally unset → dual-stack bind on the host stack
# (Network=host); exposure is governed by nftables, not by the bind.
ACCOUNT_ENV={{ account_env }}
ACCOUNT_PORT={{ account_port }}
ACCOUNT_LOG_LEVEL={{ account_log_level }}
ACCOUNT_DB_URL={{ account_db_url }}

# --- the PRIVATE minting keys this host holds (chat host gets only the pubs) ---
VOUCHER_SEED={{ account_voucher_seed }}
VOUCHER_BUDGET={{ account_voucher_budget }}
ANON_ISSUER_KEY={{ account_secrets_dir }}/anon-issuer-priv.pem
ANON_TOKEN_BUDGET={{ account_anon_token_budget }}
{% if account_tls_cert and account_tls_key %}

# --- in-process wss:// (else front with a TLS proxy) ---
ACCOUNT_TLS_CERT={{ account_tls_cert }}
ACCOUNT_TLS_KEY={{ account_tls_key }}
{% endif %}

# --- email verification ---
EMAIL_BACKEND={{ account_email_backend }}
{% if account_email_backend == 'smtp' %}
SMTP_HOST={{ account_smtp.host | default('') }}
SMTP_PORT={{ account_smtp.port | default(587) }}
SMTP_USER={{ account_smtp.user | default('') }}
{% if account_smtp_pass is defined %}
SMTP_PASS={{ account_smtp_pass }}
{% endif %}
SMTP_FROM={{ account_smtp.from | default('no-reply@localhost') }}
EMAIL_VERIFY_BASE={{ account_smtp.verify_base | default('') }}
{% endif %}
{% if account_welcome_bot %}

# keep in sync with the chat host
WELCOME_BOT={{ account_welcome_bot }}
{% endif %}
{% if account_paddle_price_id %}

# --- billing (Paddle) — account plane; secrets from the vault ---
PADDLE_PRICE_ID={{ account_paddle_price_id }}
PADDLE_API_BASE={{ account_paddle_api_base }}
{% if account_paddle_api_key is defined %}
PADDLE_API_KEY={{ account_paddle_api_key }}
{% endif %}
{% if account_paddle_webhook_secret is defined %}
PADDLE_WEBHOOK_SECRET={{ account_paddle_webhook_secret }}
{% endif %}
{% if account_paddle_success_url %}
PADDLE_SUCCESS_URL={{ account_paddle_success_url }}
{% endif %}
{% if account_webhook_port %}
ACCOUNT_WEBHOOK_PORT={{ account_webhook_port }}
{% endif %}
{% endif %}
