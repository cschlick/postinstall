# Managed by Ansible (roles/chat_server). Read by podman (root) and injected into
# the container. Config surface: postmodern-server/config.py + CONTAINER.md.
# CHAT_HOST intentionally unset → dual-stack bind on the host stack (Network=host);
# exposure is governed by nftables, not the bind.
CHAT_ENV={{ chat_env }}
CHAT_PORT={{ chat_port }}
CHAT_LOG_LEVEL={{ chat_log_level }}

# --- backbone ---
NATS_URL={{ chat_nats_url }}
CHAT_DB_URL={{ chat_db_url_effective }}

# --- object store ---
CHAT_OBJECT_STORE={{ chat_object_store }}
{% if chat_object_store == 'r2' %}
CHAT_R2_ACCOUNT_ID={{ chat_r2_account_id }}
CHAT_R2_ACCESS_KEY_ID={{ chat_r2_access_key_id }}
CHAT_R2_SECRET_ACCESS_KEY={{ chat_r2_secret_access_key }}
{% endif %}
CHAT_AVATAR_BUCKET={{ chat_avatar_bucket }}
CHAT_BODY_STORE={{ chat_body_store }}

# --- cross-plane trust: PUBLIC verify keys + this plane's OWN secrets ---
CHAT_VOUCHER_PUBKEY={{ chat_voucher_pubkey }}
CHAT_ANON_ISSUER_PUB={{ chat_secrets_dir }}/anon-issuer-pub.pem
CHAT_VC_ISSUER_SEED={{ chat_vc_issuer_seed }}
CHAT_BOT_CLAIM_SECRET={{ chat_bot_claim_secret }}
{% if chat_tls_cert and chat_tls_key %}

# --- in-process wss:// (else front with a TLS proxy) ---
CHAT_TLS_CERT={{ chat_tls_cert }}
CHAT_TLS_KEY={{ chat_tls_key }}
{% endif %}
{% if chat_system_mods %}
CHAT_SYSTEM_MODS={{ chat_system_mods }}
{% endif %}
{% if chat_welcome_bot %}
CHAT_WELCOME_BOT={{ chat_welcome_bot }}
{% endif %}
{% if chat_moderation_url %}
CHAT_MODERATION_URL={{ chat_moderation_url }}
{% if chat_moderation_api_key is defined %}
CHAT_MODERATION_API_KEY={{ chat_moderation_api_key }}
{% endif %}
{% endif %}
