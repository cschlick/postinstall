{# Managed by Ansible (roles/chat_server). Quadlet → systemd generates
   chat.service on `systemctl daemon-reload`. Runtime contract:
   postmodern-server/CONTAINER.md. #}
[Unit]
Description=postmodern chat server (container)
Documentation=https://github.com/postmodern-you/postmodern-server
After=network-online.target
Wants=network-online.target

[Container]
Image={{ chat_image }}
# Private GHCR package → podman finds the read:packages authfile via
# REGISTRY_AUTH_FILE in [Service] below. (AuthFile= is NOT a valid quadlet
# [Container] key — it makes the generator reject the whole unit.)
# newer = re-check the registry on each (re)start (for a mutable tag like
# :latest); missing = pull only when absent (immutable version tags).
Pull={{ 'newer' if chat_pull_always else 'missing' }}
# host stack: reach the backbone (mesh/managed Postgres, NATS, R2) with no
# container networking, and let the host nftables govern :{{ chat_port }} directly.
Network=host
EnvironmentFile={{ chat_env_file }}
# Secrets (DB TLS material + the anon-issuer PUBLIC key) bind-mounted read-only. The
# image runs as uid {{ chat_uid }}; rootful podman maps that to the host pm user that owns these.
Volume={{ chat_secrets_dir }}:{{ chat_secrets_dir }}:ro
{% if chat_db_local %}
# Local DB: bind-mount the postgres socket dir so the container reaches the
# co-located cluster over the Unix socket (peer auth as pm — no TLS/password).
Volume={{ chat_db_socket_dir }}:{{ chat_db_socket_dir }}:ro
{% endif %}
{% if chat_db_host | length > 0 %}
# Remote mesh DB: bind-mount the mesh client identity (client.*, ca.crt) that the
# mTLS DSN references, so the container can present it to the mesh Postgres.
Volume={{ mesh_client_tls_dir }}:{{ mesh_client_tls_dir }}:ro
{% endif %}

[Service]
# Give podman the GHCR pull-secret (quadlet has no [Container] AuthFile key).
Environment=REGISTRY_AUTH_FILE={{ chat_authfile }}
Restart=on-failure
RestartSec=5
# first boot pulls the image — give it room before systemd calls the start failed.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
